node_modules/
dist/
.env
.env.*
*.log
**/.DS_Store
.DS_Store
.claude/
.worktrees/
# Internal planning + spec artifacts produced by sub-agents and saved
# under docs/superpowers/. Public docs (architecture, ADRs, guides)
# can live elsewhere under docs/ and will be tracked normally.
docs/superpowers/
.superpowers/
coverage/
.vscode/
.idea/
*.swp
*.swo
.worktrees/
.mma/
# Derived SQLite journal index — rebuildable from .mma/journal/nodes/ via
# `mma journal reindex`; never committable. Already covered by the `.mma/`
# rule above; listed explicitly so the derived cache stays out of git even if
# the `.mma/` tree is ever un-ignored.
.mma/journal/index.db
.mma/journal/index.db-wal
.mma/journal/index.db-shm
*.tgz
full-smoke-results.json

# pnpm local store (package-manager cache, never commit)
.pnpm-store/

# TypeScript incremental build info (build artifact)
*.tsbuildinfo

# Journal-engine benchmark OUTPUTS — regenerated on every `npm test` by
# tests/perf/journal-engine-benchmark-gates.test.ts (dated raw JSON + summary, with
# per-run latency jitter). The perf GATES are the test's numeric assertions, not these
# files; the sources (run.ts, queries.ts, fixture-3000.ts) stay tracked.
benchmarks/journal/benchmark-*.json
benchmarks/journal/report-summary.md
